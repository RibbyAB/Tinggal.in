// ============================================================
// Kost Management System - Prisma Schema
// Relational design: User -> Tenant -> Rental -> Room
//                     Rental -> Bill -> Payment
//                     Tenant -> Complaint -> ComplaintUpdate
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  TENANT
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum RoomType {
  STANDARD
  DELUXE
  VIP
}

enum RentalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BillStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  OVERDUE
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  E_WALLET
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ComplaintCategory {
  ELECTRICITY
  WATER
  FACILITY
  CLEANLINESS
  SECURITY
  OTHER
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ------------------------------------------------------------
// MODELS
// ------------------------------------------------------------

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String // bcrypt hash - never returned to client
  phone        String?
  role         Role     @default(TENANT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // A User with role TENANT has exactly one Tenant profile
  tenant       Tenant?

  // Actions performed by this user (admin/owner actions), kept for audit history
  activityLogs      ActivityLog[]
  verifiedPayments  Payment[]        @relation("PaymentVerifiedBy")
  handledComplaints ComplaintUpdate[] @relation("ComplaintUpdatedBy")

  @@index([role])
  @@map("users")
}

model Room {
  id          Int        @id @default(autoincrement())
  roomNumber  String     @unique
  floor       Int
  type        RoomType   @default(STANDARD)
  price       Decimal    @db.Decimal(12, 2) // current monthly price
  capacity    Int        @default(1)
  status      RoomStatus @default(AVAILABLE)
  facilities  String?    @db.Text // comma separated or JSON string, kept simple on purpose
  description String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  rentals Rental[]

  @@index([status])
  @@index([type])
  @@index([floor])
  @@map("rooms")
}

model Tenant {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ktpNumber       String?  @unique // Indonesian ID number, optional
  emergencyContact String?
  address         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rentals    Rental[]
  complaints Complaint[]

  @@map("tenants")
}

// Rental represents one tenant occupying one room for a period of time.
// Historical price is copied from Room.price at check-in time so that
// changing a room's price later never rewrites past rentals/bills.
model Rental {
  id            Int          @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roomId        Int
  room          Room         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  monthlyPrice  Decimal      @db.Decimal(12, 2) // snapshot of Room.price at check-in
  startDate     DateTime
  endDate       DateTime? // set on checkout
  status        RentalStatus @default(ACTIVE)
  notes         String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  bills Bill[]

  // Business rule: a tenant cannot have two ACTIVE rentals at once.
  // Enforced in service layer (Prisma cannot express "one active row per tenant"
  // directly), but indexed here for fast lookups.
  @@index([tenantId, status])
  @@index([roomId, status])
  @@map("rentals")
}

// One Bill per rental per month. Unique constraint prevents duplicates.
model Bill {
  id          Int        @id @default(autoincrement())
  rentalId    Int
  rental      Rental     @relation(fields: [rentalId], references: [id], onDelete: Restrict)
  billMonth   Int // 1-12
  billYear    Int
  amount      Decimal    @db.Decimal(12, 2)
  dueDate     DateTime
  status      BillStatus @default(UNPAID)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  payments Payment[]

  @@unique([rentalId, billMonth, billYear], name: "uniqueBillPerMonth")
  @@index([status])
  @@index([billYear, billMonth])
  @@map("bills")
}

model Payment {
  id             Int           @id @default(autoincrement())
  billId         Int
  bill           Bill          @relation(fields: [billId], references: [id], onDelete: Restrict)
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod @default(BANK_TRANSFER)
  proofFilePath  String? // stored path, not binary data
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime      @default(now())
  verifiedById   Int?
  verifiedBy     User?         @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt     DateTime?
  rejectionNote  String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([billId])
  @@map("payments")
}

model Complaint {
  id          Int               @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String            @db.Text
  category    ComplaintCategory @default(OTHER)
  priority    ComplaintPriority @default(MEDIUM)
  status      ComplaintStatus   @default(OPEN)
  imagePath   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  updates ComplaintUpdate[]

  @@index([status])
  @@index([priority])
  @@index([category])
  @@map("complaints")
}

// Every status change / note on a complaint is logged as an update,
// so the full handling history is visible (who did what, when).
model ComplaintUpdate {
  id          Int             @id @default(autoincrement())
  complaintId Int
  complaint   Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  updatedById Int
  updatedBy   User            @relation("ComplaintUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  status      ComplaintStatus
  note        String?         @db.Text
  createdAt   DateTime        @default(now())

  @@index([complaintId])
  @@map("complaint_updates")
}

// Append-only audit trail. Kept independent of other records (no cascading
// deletes reach it) so history survives even if a related user is deactivated.
model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // e.g. "ROOM_CREATED", "PAYMENT_APPROVED", "RENTAL_CHECKOUT"
  entity    String // e.g. "Room", "Payment"
  entityId  Int?
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}
