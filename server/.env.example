# MySQL connection string used by Prisma
DATABASE_URL="mysql://root:password@localhost:3306/kost_management"

# Secret used to sign JWTs - use a long random string in real deployments
JWT_SECRET="replace-this-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"

PORT=5000

# Frontend origin, used for CORS
CLIENT_URL="http://localhost:5173"
